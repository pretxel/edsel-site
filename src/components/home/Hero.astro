---
import type { Language } from "../../lib/i18n";
import { t } from "../../lib/i18n";
import SparklingSphere from "../Particles/sparklingSphere";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

// Per-visit random palette. SSR runs this on every request (Vercel adapter
// = server output), so each page load — including ClientRouter navigations
// — picks a fresh palette. All six stay bright/saturated against zinc-950.
const palettes: number[][] = [
  [0x46b4ff, 0x6cc4ff, 0x88ccff], // brand blue
  [0x9b6cff, 0xb088ff, 0xc4a8ff], // violet
  [0xff6cc4, 0xff88d4, 0xffaae0], // pink
  [0xff8a6c, 0xffa888, 0xffc0a8], // coral
  [0x46ffc4, 0x6cffd4, 0x88ffe0], // mint
  [0xa8ff6c, 0xbcff88, 0xccffa8], // lime
];
const particleColors = palettes[Math.floor(Math.random() * palettes.length)];

const projectsHref = lang === "en" ? "/en/projects" : "/projects";
---

<section
  class="relative isolate overflow-hidden border-b border-border-default"
  aria-labelledby="hero-title"
>
  <!--
    Decorative sphere. Lives behind the hero copy at low opacity so it
    feels like depth, not the whole show. Hidden from assistive tech.

    Two mounts, one per viewport class, so each gets the cheapest path:

      • Desktop (≥768px): React island, `client:media`, 600 particles.
      • Mobile  (<768px): no island. The inline module script below waits
        for `load` + an idle period, then dynamically imports the plain
        Three.js scene (no React runtime) with fewer particles, a capped
        pixel ratio, no MSAA and no bloom pass. The hero heading is server-rendered text
        and stays the LCP element; the ~500KB Three.js chunk is fetched
        only once the page is already painted and interactive.

    Both containers are absolutely positioned inside a section with a fixed
    min-height, so a late canvas mount cannot shift layout. The scene
    itself skips mounting under prefers-reduced-motion and Save-Data, and
    pauses its render loop while offscreen or in a background tab.
  -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 hidden opacity-40 md:block"
    aria-hidden="true"
  >
    <SparklingSphere
      particleColors={particleColors}
      totalParticles={600}
      mobileTotalParticles={300}
      client:media="(min-width: 768px)"
    />
  </div>
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-60 md:hidden"
    aria-hidden="true"
    data-hero-sphere
    data-colors={JSON.stringify(particleColors)}
  >
  </div>

  <!-- Subtle gradient fade-to-bg at the bottom so the next section meets a
       calm surface instead of fighting the sphere's brightness. -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-32 bg-gradient-to-b from-transparent to-bg"
    aria-hidden="true"
  >
  </div>

  <div
    class="mx-auto flex min-h-[80vh] max-w-6xl flex-col items-start justify-center px-6 py-24 sm:px-8 md:min-h-[88vh] md:py-32"
  >
    <h1
      id="hero-title"
      class="max-w-3xl text-4xl font-bold leading-tight tracking-tight text-fg-strong sm:text-5xl md:text-6xl"
    >
      {t("home.hero.title", {}, lang)}
    </h1>

    <p
      class="mt-6 max-w-2xl text-lg leading-relaxed text-fg-muted sm:text-xl"
    >
      {t("home.hero.subtitle", {}, lang)}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-3">
      <a
        href={projectsHref}
        class="inline-flex items-center justify-center rounded-md bg-accent px-5 py-3 text-sm font-semibold text-bg shadow-sm transition-colors duration-200 hover:bg-accent-hover active:bg-accent-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {t("home.hero.cta.projects", {}, lang)}
        <span aria-hidden="true" class="ml-2">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<script>
  // Mobile hero animation — see the comment on the sphere containers above.
  const MOBILE = "(max-width: 767.98px)";
  const REDUCED_MOTION = "(prefers-reduced-motion: reduce)";
  const MOBILE_PARTICLES = 220;

  let cleanup: (() => void) | null = null;

  const whenIdle = (callback: () => void) => {
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(callback, { timeout: 2500 });
    } else {
      // Safari: no requestIdleCallback. A short timeout after `load` gets
      // us past first paint and hydration of anything else on the page.
      setTimeout(callback, 400);
    }
  };

  const mount = async () => {
    const host = document.querySelector<HTMLElement>("[data-hero-sphere]");
    if (!host || host.dataset.mounted === "true") return;
    if (!window.matchMedia(MOBILE).matches) return;
    if (window.matchMedia(REDUCED_MOTION).matches) return;
    const connection = (
      navigator as Navigator & { connection?: { saveData?: boolean } }
    ).connection;
    if (connection?.saveData) return;

    host.dataset.mounted = "true";
    const { mountSphere } = await import("../Particles/sphereScene");
    // The visitor may have navigated away while the chunk was loading.
    if (!host.isConnected) return;
    cleanup = mountSphere(host, {
      particleColors: JSON.parse(host.dataset.colors ?? "[]"),
      totalParticles: MOBILE_PARTICLES,
      mobileTotalParticles: MOBILE_PARTICLES,
      maxPixelRatio: 1.5,
      antialias: false,
      bloom: false,
      fadeIn: true,
    });
  };

  const schedule = () => {
    if (document.readyState === "complete") {
      whenIdle(mount);
    } else {
      window.addEventListener("load", () => whenIdle(mount), { once: true });
    }
  };

  // `astro:page-load` fires on first load and after every ClientRouter
  // navigation; tear the scene down before the DOM is swapped out.
  document.addEventListener("astro:page-load", schedule);
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = null;
  });
</script>
