---
/**
 * Technical head shared by every page and layout: charset, viewport,
 * theme, icons and the font preload. SEO tags live in SEOHead.astro.
 *
 * Stylesheets are imported by the page or layout that renders this
 * component (`global.css` for the home/404 pages, `layout.css` for the
 * layouts) so each route ships a single Tailwind bundle.
 */
// `?url` resolves to the same fingerprinted asset the `@font-face` rule in
// @fontsource-variable/inter points at, so the preload can never go stale
// the way a hand-copied hash does.
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
---

<!-- Charset first: Lighthouse's `charset` audit wants it in the first 1024 bytes. -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />

<!-- Matches `--c-zinc-950`, the page background, so the mobile browser
     chrome blends with the site. Single source of truth for theme-color. -->
<meta name="theme-color" content="#09090b" />
<meta name="color-scheme" content="dark" />

<!--
  Preload the Latin Inter variable font so the browser discovers it before
  parsing the Tailwind CSS bundle (saves ~300ms FCP on slow 4G).
-->
<link
  rel="preload"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
  href={interLatin}
/>

<!--
  Favicon + manifest only. Apple touch icon and PNG favicons are not in
  /public, so they are not referenced: 404s for them show up as console
  errors and cost Lighthouse Best-Practices points.
-->
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="manifest" href="/site.webmanifest" />
