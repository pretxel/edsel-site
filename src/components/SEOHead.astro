---
/**
 * SEO head: everything a crawler or link-unfurler reads about the page —
 * title, description, canonical, robots, hreflang, Open Graph, Twitter Card
 * and one Schema.org JSON-LD graph.
 *
 * Technical tags (charset, viewport, theme-color, favicon, manifest, font
 * preload) belong to MainHead.astro, so nothing is emitted twice.
 */
import { getAlternates, hreflangCodes, type Language } from '../lib/i18n';
import { buildGraph, isCollectionPath, type PageKind } from '../lib/schema';
import { AUTHOR_NAME, SITE_NAME, absoluteUrl } from '../lib/site';

/**
 * Structured-data variant. Selects the Schema.org page node:
 *   - `home`            → WebPage about the Person entity.
 *   - `software-app`    → SoftwareApplication + BreadcrumbList (projects).
 * Otherwise inferred: `type="article"` → BlogPosting, `type="profile"` →
 * ProfilePage, index routes → CollectionPage, anything else → WebPage.
 */
type SchemaVariant = 'home' | 'software-app';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  language?: Language;
  /**
   * Explicit language alternates. Only needed when the two variants are not
   * a plain `/en` prefix swap (blog posts have per-language slugs, and may
   * exist in a single language). Defaults to `getAlternates(canonical)`.
   */
  alternateLanguages?: { lang: Language; url: string }[];
  /** Topic tags; emitted as `article:tag` and Schema.org keywords. */
  keywords?: string[];
  noindex?: boolean;
  schemaVariant?: SchemaVariant;
  /** Project pages: application name and live URL. */
  appName?: string;
  appUrl?: string;
  /** Site-relative URL of a Markdown rendition of this page, if any. */
  markdownAlternate?: string;
}

const {
  title,
  description,
  canonical,
  image = '/og/default.png',
  imageAlt = 'Edsel Serrano - Full Stack Developer',
  type = 'website',
  publishedTime,
  modifiedTime,
  author = AUTHOR_NAME,
  language = 'es',
  alternateLanguages,
  keywords = [],
  noindex = false,
  schemaVariant,
  appName,
  appUrl,
  markdownAlternate,
} = Astro.props;

const canonicalPath = canonical ?? Astro.url.pathname;
const fullCanonical = absoluteUrl(canonicalPath);
const fullImage = absoluteUrl(image);
const langCode = hreflangCodes[language];

// ── hreflang ──────────────────────────────────────────────────────────
// x-default is the Spanish variant of *this* page. A page that exists in a
// single language only self-references and gets no x-default.
let hreflangLinks: { hreflang: string; href: string }[] = [];
if (!noindex) {
  let es: string | undefined;
  let en: string | undefined;
  if (alternateLanguages) {
    es = alternateLanguages.find((a) => a.lang === 'es')?.url;
    en = alternateLanguages.find((a) => a.lang === 'en')?.url;
  } else {
    ({ es, en } = getAlternates(canonicalPath));
  }
  if (es) hreflangLinks.push({ hreflang: hreflangCodes.es, href: absoluteUrl(es) });
  if (en) hreflangLinks.push({ hreflang: hreflangCodes.en, href: absoluteUrl(en) });
  if (es && en) hreflangLinks.push({ hreflang: 'x-default', href: absoluteUrl(es) });
}
const localeAlternates = hreflangLinks
  .map((link) => link.hreflang)
  .filter((code) => code !== 'x-default' && code !== langCode);

// ── Structured data ───────────────────────────────────────────────────
let kind: PageKind = 'page';
if (schemaVariant === 'home') kind = 'home';
else if (schemaVariant === 'software-app') kind = 'project';
else if (type === 'article') kind = 'post';
else if (type === 'profile') kind = 'about';
else if (isCollectionPath(canonicalPath)) kind = 'collection';

const graph = buildGraph({
  kind,
  url: fullCanonical,
  title,
  description,
  language,
  image: fullImage,
  imageAlt,
  publishedTime,
  modifiedTime,
  keywords,
  appName,
  appUrl,
});
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={author} />
<link rel="canonical" href={fullCanonical} />

{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
)}

{hreflangLinks.map(({ hreflang, href }) => (
  <link rel="alternate" hreflang={hreflang} href={href} />
))}

{/* Markdown rendition for LLM agents — see /llms.txt for the full index. */}
{markdownAlternate && (
  <link rel="alternate" type="text/markdown" href={absoluteUrl(markdownAlternate)} />
)}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={fullCanonical} />
<meta property="og:image" content={fullImage} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={langCode.replace('-', '_')} />
{localeAlternates.map((code) => (
  <meta property="og:locale:alternate" content={code.replace('-', '_')} />
))}

{type === 'article' && (
  <>
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta property="article:author" content={author} />
    <meta property="article:section" content={language === 'en' ? 'Technology' : 'Tecnología'} />
    {keywords.slice(0, 5).map((keyword) => (
      <meta property="article:tag" content={keyword} />
    ))}
  </>
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@edselserrano" />
<meta name="twitter:creator" content="@edselserrano" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<meta name="format-detection" content="telephone=no" />

<!-- Schema.org JSON-LD: one graph per page (see src/lib/schema.ts). -->
<script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
